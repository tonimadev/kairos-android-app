{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push origin master*)",
      "Bash(git push origin HEAD:master*)",
      "Bash(git push * master*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git commit --no-verify*)",
      "Edit(.github/workflows/**)",
      "Edit(fastlane/Fastfile)",
      "Edit(fastlane/Appfile)",
      "Edit(config/detekt/**)",
      "Edit(**/lint-baseline.xml)",
      "Edit(spotless.gradle)",
      "Edit(.editorconfig)",
      "Edit(local.properties)",
      "Edit(**/google-services.json)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-kotlin.sh",
            "timeout": 120,
            "statusMessage": "Formatting with Spotless..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify.sh",
            "timeout": 900,
            "statusMessage": "Running quality gate (spotless, detekt, unit tests, translations)..."
          }
        ]
      }
    ]
  }
}
